const BASE_URL = "http://localhost:3007";
const RESOURCE_URL = `${BASE_URL}/perfumes`;

const baseRequest = async ({ urlPath = "", method = "GET", body = null }) => {
    try {
        const reqParams = {
            method,
            headers: {
                "Content-Type": "application/json",
            },
        };

        if (body) {
            reqParams.body = JSON.stringify(body);
        }

        const response = await fetch(`${RESOURCE_URL}${urlPath}`, reqParams);
        
       
        if (!response.ok) {
            throw new Error(`HTTP error! status: ${response.status}`);
        }

        return await response.json();
    } catch (error) {
        console.error("HTTP ERROR: ", error);
    }
};


export const getAllPerfumes = async () => {
    return await baseRequest({ method: "GET" });
};


export const postPerfume = async (body) => {
    return await baseRequest({ method: "POST", body });
};


export const updatePerfume = async (id, body) => {
    return await baseRequest({ urlPath: `/${id}`, method: "PATCH", body });
};


export const deletePerfume = async (id) => {
    return await baseRequest({ urlPath: `/${id}`, method: "DELETE" });
};


export const searchPerfumes = async (query) => {
    return await baseRequest({ urlPath: `/search?query=${query}`, method: "GET" });
};


export const sortPerfumesByPrice = async () => {
    return await baseRequest({ urlPath: "/sort/price", method: "GET" });
};


export const sortPerfumesByVolume = async () => {
    return await baseRequest({ urlPath: "/sort/volume", method: "GET" });
};

