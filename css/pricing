.pricing {
    padding-top: 59px;
    margin: 0 auto;
}

.pricing__paragraph {
    width: 730px;
    color: #6F7CB2;
    font-size: 16px;
    font-weight: 400;
    line-height: 26px;
    margin-bottom: 88px;
}

.info {
    display: flex;
    gap: 30px; 
}

.price__title {
    display: flex;
    color: #37447E;
    font-size: 36px;
    font-weight: 500;
    line-height: 48px;
    width: 350px;
    margin: 0 auto;
}

.info__title {
    color: #091133;
    font-size: 22px;
    font-weight: 500;
    line-height: 32px;
    margin-top: 16px;
}

.info__text {
    color: #5D6970;
    font-size: 14px;
    font-weight: 400;
    line-height: 24px;
}

.info__button {
    display: flex; 
    justify-content: center;
    align-items: center;
    background-color: #111B47; 
    color: white; 
    width: 189px;
    height: 26px; 
    border-radius: 2px; 
    font-size: 12px;
    font-weight: 500;
    margin-top: 30px;
    border: none;
    text-decoration: none; 
    transition: background-color 0.3s, transform 0.3s; 
}

.info__button:hover {
    background-color: #4d65dc; 
    transform: scale(1.05); 
}

@media screen and (min-width: 320px) and (max-width: 768px) { 
    .pricing__paragraph {
        font-size: 14px;
        text-align: center;
        width: 80%;
    }

    .price__title {
        text-align: center;   
        display: flex;
        justify-content: center;
        align-items: center;
        width: 80%;
    }
  
    .info1 , .info2 , .info3 {
        margin: 0 auto; 
        text-align: center; 
        padding: 45px; 
        margin-bottom: 20px; 


    }

    .info {
        display: flex;
        flex-direction: column; 
        gap: 20px; 
        align-items: center;
    }
   

    .pricing {
        display: flex;
        flex-direction: column;
        align-items: center; 
        margin: 0 auto;
        padding: 0;
    }

    .title , .pricing__paragraph {
        width: 90%;
        margin-top: 0;
        display: flex;
        flex-direction: column;
        align-items: center; 
    }

    .title {
        text-align: center; 
    }

    .info__button {
        display: flex;
        align-items: center; 
        justify-content: center; 
        margin: 0 auto; 
    }

    .info1 , .info2 , .info3 {
        padding-bottom: 30px; 
        text-align: center; 
    }

}



@media screen and (min-width: 769px) and (max-width: 1280px) { 
    .pricing {
        align-items: center;
    }
}

