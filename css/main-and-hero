.hero__inner{
    position: relative;
    width: 540px;
    padding-top: 120px;
    
}

.hero_title{
    color: #091133;
    font-size: 36px;
    font-style: normal;
    font-weight: 500;
    line-height: 48px;
    margin-bottom: 23px;
}

.main__inner{
    position: relative;
    width: 540px;
    padding-top: 160px;
}

.main_inner-title {
    color: #091133;
    font-size: 36px;
    font-style: normal;
    font-weight: 500;
    line-height: 48px;
    margin-bottom: 23px;
}

.icon-container1 {
    display: flex;
    justify-content: flex-start;
    gap: 30px;
    margin-bottom: 360px; 
    margin-top: 45px; 
}


.icon-container2 {
    display: flex;
    justify-content: flex-start;
    gap: 30px;
    margin-bottom: 259px; 
    margin-top: 80px; 
}

.icon-item {
    text-align: left; 
    width: 255px;
}

.icon-item img {
    width: 36px; 
    height: auto; 
}

.icon-title {
    color: #091133; 
    font-size: 16px; 
    font-style: normal; 
    font-weight: 500; 
    line-height: 26px; 
    margin: 14px 0 6px 0; 
    
}

.icon-text {
    color: #5D6970;
    font-size: 12px; 
    font-weight: 400; 
    line-height: 18px; 
    
}

.tablet-image-container1 {
    max-width: 645px; 
    height: auto; 
    flex-shrink: 0; 
    margin-left: 700px;
    margin-top: -800px;
    position: absolute;
    overflow: hidden; 

}

.tablet-image-container1 img {
    max-width: 100%;
    height: auto; 
}

.illustration{
    width: 90%;
    height: auto;
    object-fit: contain; 
  }
  
  .illustration img {
    position: absolute;
    top: 180px;
    left: 560px;
    width: 540px;
  }
  


@media screen and (min-width: 320px) and (max-width: 768px) { 
    .hero__inner, .main__inner {
        width: 90%;
        padding-top: 60px;
        text-align: center;
    }

    .hero_title, .main_inner-title {
        font-weight: 500;
        font-size: 24px;
        text-align: center;
        line-height: 36px;
        margin-bottom: 20px;
    }

    .icon-container1, .icon-container2 {
        flex-direction: column;
        gap: 30px;
        align-items: center;
        margin: 0px;
        padding: 20px;
        margin-bottom: 20px;
    }

    .icon-item {
        width: 100%;
        text-align: center;
        padding-bottom: 30px;
    }

    .icon-item img {
        width: 50px;
        height: auto;
    }

    .icon-title {
        font-size: 18px;
        margin: 10px 0;
    }

    .icon-text {
        font-size: 14px;
        text-align: center;
    }

    .tablet-image-container1 {
        width: 90%;
        margin: 0 auto;
        position: relative;
    }

    .tablet-image-container1 img {
        width: 90%;
        height: auto;
    }

    .illustration {
        width: 90%;
        height: auto;
        object-fit: contain;
        position: relative; 
        right: 550px; 
        transform: translateY(-230px); 
    }
    
    .illustration img {
        width: 100%;
        height: auto;
        position: relative; 
        z-index: 1; 
    }
    
}    

