.footer {
    background-color: #E7ECFF;
    padding: 20px 0;
    height: 282px;
    width: 100%;
    position: relative;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.footer__date {
    position: absolute;
    top: 37px;
    left: 165px;
    width: 83px;
    height: 24px;
    color: #939EA4;
    font-size: 14px;
    font-weight: 500;
    line-height: 24px;
}

.footer__title {
    position: absolute;
    top: 42px;
    right: 165px;
    font-size: 26px;
    color: #37447E;
    font-weight: 900;
    white-space: nowrap;
}

.footer__container {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 80px;
}

.footer__line {
    width: 1110px;
    border: 1px solid #CDD1D4;
}

.footer__button {
    background-color: #111B47;
    display: flex;
    justify-content: center;
    align-items: center;
    width: 109px;
    height: 26px;
    color: white;
    font-size: 12px;
    font-weight: 500;
    border: none;
    border-radius: 2px;
    cursor: pointer;
    margin-top: 15px;
    text-decoration: none;
}

.footer__links {
    display: flex;
    justify-content: center;
}

.footer__links ul {
    padding: 0;
    display: flex;
    gap: 55px;
    margin: 0 auto;
}

.footer__links ul li {
    display: inline-block;
    margin-top: 22px;
}

.footer__links ul li a {
    margin: 0 auto;
    color: #929ECC;
    text-decoration: none;
    font-size: 14px;
    flex-shrink: 0;
    margin-bottom: 26px;
}

.footer__links ul li a:hover {
    color: darkblue;
}

.footer_social {
    margin-top: 30px;
    display: flex;
    justify-content: center;
}

.footer_social a {
    margin: 0 10px;
    display: inline-block;
    transition: transform 0.3s ease, filter 0.3s ease; 
    border-radius: 50%; 
    padding: 10px; 
    display: flex;
    justify-content: center;
    align-items: center;
}

.footer_social a:hover {
    transform: scale(1.1); 
    background-color: #040438; 
}

.footer_social img {
    width: 16px;
    height: 16px;
}

.footer__button {
    transition: background-color 0.3s, transform 0.3s; 
}

.footer__button:hover {
    background-color: #4d65dc; 
    transform: scale(1.05);
}




@media screen and (min-width: 320px) and (max-width: 768px) {
    .footer {
        padding: 20px 10px;
        height: auto;
        flex-direction: column; 
    }

    .footer__title {
        position: static; 
        text-align: center; 
        margin-bottom: 10px; 
    }

    .footer__date {
        position: static; 
        margin-bottom: 10px; 
        text-align: center;
    }

    .footer__container {
        padding-top: 40px; 
    }

    .footer__line {
        width: 90%; 
    }

    .footer__button {
        margin-bottom: 30px; 
    
    }
    .footer__links ul {
        gap: 10px; 
    }

    .footer__links ul li {
        margin-top: 0; 
    }

    .footer__links ul li a {
        font-size: 14px;
        margin-bottom: 10px; 
    }

    .footer_social {
        margin-top: 20px; 
    }

    .footer_social img {
        width: 20px; 
        height: 20px;
    }
}

@media screen and (min-width: 769px) and (max-width: 1280px){
    .footer {
        background-color: #E7ECFF;
        padding: 20px 0;
        height: 282px;
        width: 100%;
        position: relative;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-top: 20px;
    }

    .footer__date {
        font-size: 12px; 
    }

    .footer__title {
        font-size: 20px; 
    }

    .footer__line {
        max-width: 100%; 
    }

    .footer__button {
        margin-top: 20px; 
        font-size: 12px; 
        padding: 8px 12px; 
    }

    .footer__links ul li a {
        font-size: 12px; 
    }

    .footer_social img {
        width: 12px;
        height: 12px;
    }
}
